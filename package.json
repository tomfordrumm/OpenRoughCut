{
  "name": "openroughcut-workspace",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "author": "OpenRoughCut",
  "description": "Create silence-cut editable timelines for Final Cut Pro, Premiere Pro, and DaVinci Resolve.",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "apps/desktop"
  ],
  "scripts": {
    "start": "node ./packages/cli/src/cli.js",
    "cli": "node ./packages/cli/src/cli.js",
    "app": "npm run app -w apps/desktop",
    "app:build": "npm run app:build -w apps/desktop",
    "app:preview": "npm run app:preview -w apps/desktop",
    "smoke:runtime-download": "npm run smoke:runtime-download -w apps/desktop",
    "dist": "npm run dist -w apps/desktop",
    "dist:mac": "npm run dist:mac -w apps/desktop",
    "dist:mac:arm64": "npm run dist:mac:arm64 -w apps/desktop",
    "dist:mac:x64": "npm run dist:mac:x64 -w apps/desktop",
    "dist:win": "npm run dist:win -w apps/desktop",
    "test": "node --test packages/core/test/*.test.js packages/cli/test/*.test.js apps/desktop/test/*.test.js test/*.test.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "shell-quote": "1.10.0",
    "brace-expansion@^1.1.7": "1.1.21",
    "brace-expansion@^2.0.1": "2.1.7",
    "brace-expansion@^5.0.5": "5.0.12",
    "tar": "7.5.22"
  }
}
